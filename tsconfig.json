{
    "$schema": "https://www.schemastore.org/tsconfig",
    "compilerOptions": {
        "lib": [
            "es2024",
            "ESNext.Array",
            "ESNext.Collection",
            "ESNext.Error",
            "ESNext.Iterator",
            "ESNext.Promise"
        ],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "sourceMap": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
